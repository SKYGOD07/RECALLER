# RECALLER — runtime configuration.
#
# Copy to .env (git-ignored) and fill in what you need. Every value here is
# optional: with no model configured RECALLER runs fully deterministic, and the
# agent endpoints answer 503 LLM_NOT_CONFIGURED rather than guessing.
#
# No model ever computes money. EMI, FOIR, LTV, eligibility and the verdict come
# from the credit and policy engines; the model reads documents and explains a
# decision that already exists.

# ---------------------------------------------------------------- model

# auto (default) | anthropic | ollama | none
#   auto: Claude if its key is set, else Ollama if a host or key is set, else none.
# RECALLER_LLM_PROVIDER=auto

# Defaults to claude-opus-5 (Anthropic) or llama3.1 (Ollama).
# RECALLER_LLM_MODEL=

# --- Claude ---
# ANTHROPIC_API_KEY=
# RECALLER_LLM_EFFORT=            # low | medium | high | xhigh | max

# --- Ollama (local or Ollama Cloud) ---
#   ollama serve && ollama pull llama3.1
# RECALLER_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434     # https://ollama.com for Cloud
# OLLAMA_API_KEY=                        # Cloud only; a local server needs none
# RECALLER_LLM_TEMPERATURE=0             # 0 keeps document reads repeatable
# RECALLER_OLLAMA_NUM_CTX=               # raise for long bank statements
# OLLAMA_KEEP_ALIVE=5m                   # how long the model stays resident

# ---------------------------------------------------------------- server

# RECALLER_DATA_DIR=
# RECALLER_MAX_UPLOAD_MB=20
# RECALLER_STAGE_PACING=1                # 0 removes the demo pacing between stages
# RECALLER_CORS_ORIGINS=                 # comma-separated, added to the defaults
