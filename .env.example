# RECALLER — runtime configuration.
#
# Copy this file to .env in the same folder (the repository root). .env is
# git-ignored, so a key put there never reaches GitHub. Every line is optional:
# anything left commented uses the default shown, which is the value in DEFAULTS
# in recaller/config.py. Restart the backend after editing.
#
#   What is in effect:   GET /api/diagnostics/config, or the console's System screen
#   Is the model live:   .venv\Scripts\python -m recaller.cli check-llm
#                        (or "Send test prompt" on the System screen)
#
# No model ever computes money. EMI, FOIR, LTV, eligibility and the verdict come
# from the credit and policy engines; the model reads documents and explains a
# decision that already exists.

# ================================================================ model

# auto (default) | anthropic | ollama | none
#   auto: Claude if its key is set, else Ollama if a host or key is set, else none.
# RECALLER_LLM_PROVIDER=auto
# RECALLER_LLM_MODEL=                    # overrides the provider default below

# --- Ollama Cloud: NVIDIA Nemotron 3 Ultra --------------------------------
# Create a key at https://ollama.com/settings/keys and paste it after the =.
# RECALLER_LLM_PROVIDER=ollama
# RECALLER_LLM_MODEL=nemotron-3-ultra
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=

# --- Ollama, local server --------------------------------------------------
#   ollama serve && ollama pull <model>
# OLLAMA_HOST=http://127.0.0.1:11434     # a local server needs no key
# RECALLER_OLLAMA_MODEL=llama3.1
# RECALLER_OLLAMA_CLOUD_HOST=https://ollama.com   # used when a key is set without OLLAMA_HOST

# --- Ollama tuning ---------------------------------------------------------
# RECALLER_LLM_TEMPERATURE=0             # 0 keeps document reads repeatable
# RECALLER_OLLAMA_THINK=                 # true | false | low | medium | high; empty = model default
# RECALLER_OLLAMA_NUM_CTX=               # raise for long bank statements
# OLLAMA_KEEP_ALIVE=                     # how long a local model stays resident, e.g. 5m

# --- Claude ----------------------------------------------------------------
# ANTHROPIC_API_KEY=
# RECALLER_ANTHROPIC_MODEL=claude-opus-5
# RECALLER_LLM_EFFORT=                   # low | medium | high | xhigh | max

# --- any provider ----------------------------------------------------------
# RECALLER_LLM_TIMEOUT=300               # seconds per model call
# RECALLER_LLM_MAX_TOKENS=16000          # Claude only
# RECALLER_LLM_RETRIES=4                 # Ollama: retries on 429 / 5xx / connection errors, with backoff
# RECALLER_LLM_CONCURRENCY=2             # Ollama: calls in flight at once; lower it if Cloud rate-limits you

# ================================================================ agents

# RECALLER_AGENT_MAX_ITERATIONS=12       # tool-loop turns per agent
# RECALLER_AGENT_MAX_CHILDREN=4          # delegate_task children per call (the review uses 4)

# ================================================================ server

# RECALLER_HOST=127.0.0.1
# RECALLER_PORT=4180
# RECALLER_DATA_DIR=                     # empty: ./var (packaged build: %LOCALAPPDATA%\RECALLER)
# RECALLER_MAX_UPLOAD_MB=20
# RECALLER_CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180   # the full list; the console dev server by default
# RECALLER_REQUEST_LOG_SIZE=500          # requests kept for /api/diagnostics/requests
# RECALLER_JOB_HISTORY=50                # finished jobs kept in memory
# RECALLER_SSE_KEEPALIVE_SECONDS=15
# RECALLER_SSE_RETRY_MS=3000

# ================================================================ applications

# RECALLER_APP_ID_FORMAT=RCL-{year}-{seq:04d}   # {year} is the current year; {seq} is required
# RECALLER_APP_SEQUENCE_START=500               # the first new file gets start + 1

# ================================================================ processing

# RECALLER_STAGE_PACING=1                # 0 removes the pacing between stages
# RECALLER_STAGE_PACING_SCALE=1          # multiplies every stage's hold time
# RECALLER_STAGE_PACING_SECONDS=         # per-stage overrides, e.g. BANK=2.0,KYC=0.5

# ================================================================ pattern extractor

# Confidence given to a value read verbatim off a labelled line of an uploaded
# document. Compare with the confidence floor in policy/policy.v1.json.
# RECALLER_PATTERN_CONFIDENCE=0.93
# RECALLER_PATTERN_LONG_TEXT_CONFIDENCE=0.90
