# RECALLER frontend — transport configuration.
#
# Leave both unset to run the console entirely in the browser on the
# deterministic domain packages. That is the demo / offline mode: it runs the
# same orchestrator the backend runs, so every figure, reason code and hash
# matches what the server would have produced.

# Point the console at a running RECALLER backend.
#   VITE_RECALLER_API=http://127.0.0.1:8000
#   VITE_RECALLER_API=same-origin        # the installer serves API and console together
# VITE_RECALLER_API=

# Force a transport regardless of the URL above: "http" or "engine".
# VITE_RECALLER_MODE=

# Refuse to fall back to the in-browser engine when the backend is unreachable.
# VITE_RECALLER_STRICT=true
